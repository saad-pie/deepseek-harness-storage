{
  "name": "dsh-plugin-apex-browser",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Apex AI Browser Cockpit — shared live Chromium for DSH: AI tool control, user hand-off, screencast cockpit UI",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"] }
  },
  "files": ["lib", "cordis.patch.yml"],
  "dependencies": { "playwright": "^1.65.1" }
}
